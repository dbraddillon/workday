# Normalize line endings to LF so scripts (esp. the bash installer) stay valid
# regardless of a contributor's platform/git config.
* text=auto eol=lf

*.sh text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary assets — never touch line endings.
*.png binary
*.icns binary
*.ico binary
